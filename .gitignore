# Audio, models and other large or copyrighted material never go in
*.mp3
*.wav
*.m4a
*.flac
*.npy
*.pt

# Panel scratch files: call args/results, the log, old backups (the browser check stub is kept)
LyricPanel/_tmp/*
!LyricPanel/_tmp/check.html

# Benchmark outputs (contain lyric text and linked vocals)
Pipeline Tests/out/
Pipeline Tests/compare.json

# Local-only
.claude/settings.local.json
.claude/launch.json
__pycache__/
*.pyc

LyricPanel2/_tmp/*
!LyricPanel2/_tmp/check.html

LyricPanel3/_tmp/*
!LyricPanel3/_tmp/check.html

# pasted lyric samples
example.txt

# title-card test: the scripts are kept, the pictures made from the thumbnails are not
Title Test/*.jpg
Title Test/*.png
/*.PNG

# the user's own corrected SRTs (lyric text): looked up first by the panel, never in git
Lyric Library/
